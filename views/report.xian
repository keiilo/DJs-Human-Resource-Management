{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5 no-print">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-xl md:text-2xl font-bold">{{report.title}}</h2>
          <p class="text-sm text-gray-500 mt-1">{{report.subtitle}}</p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="window.print()" class="rounded-xl bg-yellow-400 px-4 py-2.5 text-sm font-bold text-black hover:bg-yellow-300">Print</button>
          <a href="/reports" class="rounded-xl border border-white/10 px-4 py-2.5 text-sm text-gray-300 hover:bg-white/5">All reports</a>
        </div>
      </div>
    </header>

    <section class="p-6 max-w-6xl space-y-6">

      {{> flash}}

      {{#if showRange}}
      <form method="GET" action="/reports/{{type}}" class="rounded-2xl border border-white/5 bg-[#171717] p-4 flex flex-wrap items-end gap-3 no-print">
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-500 mb-2">From</label>
          <input type="date" name="from" value="{{from}}"
                 class="rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-2.5 text-sm outline-none focus:border-yellow-400/60">
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-500 mb-2">To</label>
          <input type="date" name="to" value="{{to}}"
                 class="rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-2.5 text-sm outline-none focus:border-yellow-400/60">
        </div>
        <button type="submit" class="rounded-xl bg-yellow-400 px-5 py-2.5 text-sm font-bold text-black hover:bg-yellow-300">Apply Range</button>
      </form>
      {{/if}}

      <div class="print-card rounded-2xl border border-white/5 bg-[#171717] p-6">
        <div class="flex flex-wrap items-start justify-between gap-4 border-b border-white/10 pb-5">
          <div>
            <p class="font-black text-lg">DJs Human Resource Management</p>
            <p class="text-xs text-gray-500">XianFire ERP System</p>
          </div>
          <div class="text-right">
            <p class="font-bold">{{report.title}}</p>
            <p class="text-xs text-gray-500">{{report.subtitle}}</p>
          </div>
        </div>

        {{#if report.summary}}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 py-5">
          {{#each report.summary}}
          <div class="rounded-xl border border-white/10 px-4 py-3">
            <p class="text-[11px] uppercase tracking-wider text-gray-500">{{label}}</p>
            <p class="text-lg font-black mt-1">{{value}}</p>
          </div>
          {{/each}}
        </div>
        {{/if}}

        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="border-b border-white/10 text-gray-400 uppercase text-[11px]">
              <tr>
                {{#each report.columns}}
                <th class="px-3 py-3">{{this}}</th>
                {{/each}}
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10">
              {{#each report.rows}}
              <tr>
                {{#each this}}
                <td class="px-3 py-2.5">{{this}}</td>
                {{/each}}
              </tr>
              {{else}}
              <tr><td colspan="{{report.columns.length}}" class="px-3 py-10 text-center text-gray-500">No records for this report.</td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <p class="mt-5 border-t border-white/10 pt-3 text-[11px] text-gray-500">
          Generated from the DJs HRMS database.
        </p>
      </div>

    </section>
  </main>
</div>

{{> footer}}
