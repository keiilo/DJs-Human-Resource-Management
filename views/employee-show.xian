{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-yellow-400 text-black flex items-center justify-center text-xl font-black">
            {{employee.firstName.[0]}}{{employee.lastName.[0]}}
          </div>
          <div>
            <h2 class="text-xl md:text-2xl font-bold">{{employee.firstName}} {{employee.lastName}}</h2>
            <p class="text-sm text-gray-500 mt-0.5">{{employee.position}} · {{employee.department}}</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          {{#unless isLimited}}
          <a href="/employees/{{employee.id}}/edit" class="rounded-xl bg-yellow-400 px-4 py-2.5 text-sm font-bold text-black hover:bg-yellow-300">Edit</a>
          {{/unless}}
          <a href="{{#if isLimited}}/profile{{else}}/employees{{/if}}" class="rounded-xl border border-white/10 px-4 py-2.5 text-sm text-gray-300 hover:bg-white/5">Back</a>
        </div>
      </div>
    </header>

    <section class="p-6 space-y-6">

      {{> flash}}

      <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

        <div class="xl:col-span-1 space-y-6">
          <div class="rounded-2xl border border-white/5 bg-[#171717] p-5">
            <h3 class="font-bold mb-4">Employee Details</h3>
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Employee ID</dt><dd class="font-semibold text-yellow-400">{{employee.employeeCode}}</dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Department</dt><dd>{{employee.department}}</dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Position</dt><dd>{{employee.position}}</dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Status</dt>
                <dd>
                  <span class="rounded-full px-2.5 py-1 text-[11px] {{#if (eq employee.status "Active")}}bg-green-500/10 text-green-400{{else}}{{#if (eq employee.status "On Leave")}}bg-orange-500/10 text-orange-400{{else}}bg-red-500/10 text-red-400{{/if}}{{/if}}">{{employee.status}}</span>
                </dd>
              </div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Date Hired</dt><dd>{{formatDate employee.dateHired}}</dd></div>
              {{#unless isLimited}}
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Monthly Salary</dt><dd class="font-semibold text-yellow-400">{{formatMoney employee.salary}}</dd></div>
              {{/unless}}
            </dl>
          </div>

          <div class="rounded-2xl border border-white/5 bg-[#171717] p-5">
            <h3 class="font-bold mb-4">Contact</h3>
            <dl class="space-y-3 text-sm">
              <div><dt class="text-gray-500 text-xs uppercase tracking-wider mb-1">Email</dt><dd class="break-all">{{employee.email}}</dd></div>
              <div><dt class="text-gray-500 text-xs uppercase tracking-wider mb-1">Phone</dt><dd>{{dash employee.phone}}</dd></div>
            </dl>
          </div>

          <div class="rounded-2xl border border-white/5 bg-[#171717] p-5">
            <h3 class="font-bold mb-4">Linked Account</h3>
            {{#if employee.account}}
              <p class="text-sm font-semibold">{{employee.account.name}}</p>
              <p class="text-xs text-gray-500 break-all">{{employee.account.email}}</p>
              <span class="mt-3 inline-block rounded-full bg-yellow-500/10 px-2.5 py-1 text-[11px] uppercase tracking-wider text-yellow-400">{{employee.account.role}}</span>
            {{else}}
              <p class="text-sm text-gray-500">No login account is linked yet.</p>
              <p class="text-xs text-gray-600 mt-1">The account is linked automatically when a user registers with this email.</p>
            {{/if}}
          </div>
        </div>

        <div class="xl:col-span-2 space-y-6">

          <div class="rounded-2xl border border-white/5 bg-[#171717] overflow-hidden">
            <div class="p-5 border-b border-white/5 flex items-center justify-between">
              <h3 class="font-bold">Recent Attendance</h3>
              <a href="{{#if isLimited}}/my-attendance{{else}}/attendance{{/if}}" class="text-xs text-yellow-400 hover:underline">View all →</a>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead class="bg-white/5 text-gray-400 uppercase text-[11px]">
                  <tr><th class="px-5 py-3">Date</th><th class="px-5 py-3">Check In</th><th class="px-5 py-3">Check Out</th><th class="px-5 py-3">Status</th></tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  {{#each recentAttendance}}
                  <tr>
                    <td class="px-5 py-3">{{formatDate date}}</td>
                    <td class="px-5 py-3 text-gray-400">{{formatTime checkIn}}</td>
                    <td class="px-5 py-3 text-gray-400">{{formatTime checkOut}}</td>
                    <td class="px-5 py-3">
                      <span class="rounded-full px-2.5 py-1 text-[11px] {{#if (eq status "Late")}}bg-orange-500/10 text-orange-400{{else}}{{#if (eq status "Absent")}}bg-red-500/10 text-red-400{{else}}bg-green-500/10 text-green-400{{/if}}{{/if}}">{{status}}</span>
                    </td>
                  </tr>
                  {{else}}
                  <tr><td colspan="4" class="px-5 py-8 text-center text-gray-500">No attendance records.</td></tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>

          <div class="rounded-2xl border border-white/5 bg-[#171717] overflow-hidden">
            <div class="p-5 border-b border-white/5 flex items-center justify-between">
              <h3 class="font-bold">Leave History</h3>
              <a href="/leaves" class="text-xs text-yellow-400 hover:underline">View all →</a>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead class="bg-white/5 text-gray-400 uppercase text-[11px]">
                  <tr><th class="px-5 py-3">Type</th><th class="px-5 py-3">Dates</th><th class="px-5 py-3">Days</th><th class="px-5 py-3">Status</th></tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  {{#each recentLeaves}}
                  <tr>
                    <td class="px-5 py-3 font-medium">{{type}}</td>
                    <td class="px-5 py-3 text-gray-400 text-xs">{{formatDate startDate}} → {{formatDate endDate}}</td>
                    <td class="px-5 py-3 text-gray-400">{{days}}</td>
                    <td class="px-5 py-3">
                      <span class="rounded-full px-2.5 py-1 text-[11px] {{#if (eq status "Approved")}}bg-green-500/10 text-green-400{{else}}{{#if (eq status "Rejected")}}bg-red-500/10 text-red-400{{else}}bg-yellow-500/10 text-yellow-400{{/if}}{{/if}}">{{status}}</span>
                    </td>
                  </tr>
                  {{else}}
                  <tr><td colspan="4" class="px-5 py-8 text-center text-gray-500">No leave requests.</td></tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>

          {{#if recentPayroll}}
          <div class="rounded-2xl border border-white/5 bg-[#171717] overflow-hidden">
            <div class="p-5 border-b border-white/5 flex items-center justify-between">
              <h3 class="font-bold">Recent Payslips</h3>
              <a href="/payroll" class="text-xs text-yellow-400 hover:underline">View payroll →</a>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead class="bg-white/5 text-gray-400 uppercase text-[11px]">
                  <tr><th class="px-5 py-3">Period</th><th class="px-5 py-3">Net Pay</th><th class="px-5 py-3">Status</th><th class="px-5 py-3"></th></tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  {{#each recentPayroll}}
                  <tr>
                    <td class="px-5 py-3 text-xs text-gray-400">{{formatDate periodStart}} → {{formatDate periodEnd}}</td>
                    <td class="px-5 py-3 font-semibold text-yellow-400">{{formatMoney netSalary}}</td>
                    <td class="px-5 py-3"><span class="rounded-full bg-white/5 px-2.5 py-1 text-[11px] text-gray-300">{{status}}</span></td>
                    <td class="px-5 py-3 text-right"><a href="/payroll/{{id}}" class="text-xs text-yellow-400 hover:underline">Payslip</a></td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
          {{/if}}

        </div>
      </div>

    </section>
  </main>
</div>

{{> footer}}
