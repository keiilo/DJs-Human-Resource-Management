{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-xl md:text-2xl font-bold">Edit Employee</h2>
          <p class="text-sm text-gray-500 mt-1">{{employee.firstName}} {{employee.lastName}} · {{employee.employeeCode}}</p>
        </div>
        <a href="/employees/{{employee.id}}" class="rounded-xl border border-white/10 px-4 py-2.5 text-sm text-gray-300 hover:bg-white/5">View profile</a>
      </div>
    </header>

    <section class="p-6 max-w-4xl space-y-6">
      {{> flash}}
      {{> employee-form formAction=(concat "/employees/" employee.id "/edit") submitLabel="Update Employee"}}
    </section>
  </main>
</div>

{{> footer}}
