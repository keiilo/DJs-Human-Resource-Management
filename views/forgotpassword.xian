{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="min-h-screen flex items-center justify-center p-6">
  <div class="w-full max-w-md rounded-2xl border border-white/5 bg-[#141414] p-8">

    <div class="flex items-center gap-3 mb-6">
      <div class="w-11 h-11 rounded-xl bg-yellow-400 text-black flex items-center justify-center font-black">DJ</div>
      <div>
        <p class="font-bold text-yellow-400">DJs HRMS</p>
        <p class="text-xs text-gray-500">XianFire ERP System</p>
      </div>
    </div>

    {{#if waiting}}
    {{!-- Waiting for the administrator. The page checks every few seconds and opens
          "Set a new password" by itself once HR approves. --}}
    <h1 class="text-2xl font-bold">Waiting for HR approval</h1>
    <p class="mt-2 text-sm text-gray-400">
      Request sent for <span class="text-yellow-400 break-all">{{email}}</span>.
      The HR administrator has been notified.
    </p>

    <div id="resetWaitStatus" role="status" aria-live="polite"
         class="mt-5 flex items-center gap-3 rounded-xl border border-white/5 bg-white/[0.02] p-4 text-sm text-gray-300">
      <span class="h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-yellow-400 border-t-transparent" aria-hidden="true"></span>
      <span>Keep this page open. It moves to <b>Set a new password</b> by itself once HR approves.</span>
    </div>

    <form method="POST" action="/forgot-password/cancel" class="mt-6 text-center">
      <button type="submit" class="text-sm text-gray-500 hover:text-yellow-400">Cancel and start over</button>
    </form>

    <script>
      (function () {
        var box = document.getElementById("resetWaitStatus");
        var show = function (html, tone) {
          box.className = "mt-5 rounded-xl border p-4 text-sm " + tone;
          box.innerHTML = html;
        };
        var check = function () {
          fetch("/forgot-password/status", { headers: { Accept: "application/json" }, cache: "no-store" })
            .then(function (res) { return res.json(); })
            .then(function (data) {
              if (data.status === "approved" && data.url) {
                show("Approved by HR. Opening <b>Set a new password</b>…", "border-green-500/30 bg-green-500/10 text-green-400");
                window.location.href = data.url;
              } else if (data.status === "dismissed") {
                show("HR closed this request. Contact HR, or start over to send a new one.", "border-orange-500/40 bg-orange-500/10 text-orange-400");
              } else if (data.status === "expired" || data.status === "done") {
                show("This request has expired. Start over to send a new one.", "border-orange-500/40 bg-orange-500/10 text-orange-400");
              } else {
                setTimeout(check, 3000);
              }
            })
            .catch(function () { setTimeout(check, 5000); });
        };
        setTimeout(check, 2000);
      })();
    </script>

    {{else}}
    <h1 class="text-2xl font-bold">Forgot your password?</h1>
    <p class="mt-2 text-sm text-gray-400">
      Enter the email you sign in with. The HR administrator is notified, and once HR approves,
      this page opens <b>Set a new password</b> by itself.
    </p>

    <div class="space-y-4 mt-5">{{> flash}}</div>

    <form method="POST" action="/forgot-password" class="mt-5 space-y-4">
      <div>
        <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Email address</label>
        <input id="email" type="email" name="email" required autofocus autocomplete="email" placeholder="you@company.com"
               class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
      </div>
      <button type="submit" class="w-full rounded-xl bg-yellow-400 px-4 py-3 text-sm font-bold text-black transition hover:bg-yellow-300">
        Send request to HR
      </button>
    </form>

    <ol class="mt-6 space-y-1.5 rounded-xl border border-white/5 bg-white/[0.02] p-4 text-xs text-gray-400 list-decimal list-inside">
      <li>Send this request and keep the page open.</li>
      <li>Wait for HR to approve it.</li>
      <li>This page opens <b>Set a new password</b> by itself (valid for 30 minutes).</li>
    </ol>
    {{/if}}

    <p class="mt-6 text-center text-sm text-gray-500">
      Remembered it?
      <a href="/login" class="font-semibold text-yellow-400 hover:text-yellow-300">Back to sign in</a>
    </p>
  </div>
</div>
</body>
</html>
