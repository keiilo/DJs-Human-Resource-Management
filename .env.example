# DJs HRMS settings. Copy this file to .env and fill it in. Never commit .env.
# Values already set in your shell win over this file.

PORT=3000
SESSION_SECRET=change-me

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ERP
DB_USER=root
DB_PASS=

# Rest days that are not counted as leave days: 0 = Sunday ... 6 = Saturday (comma list, e.g. 0,6)
HR_REST_DAYS=0
