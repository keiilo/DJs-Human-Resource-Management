{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="min-h-screen flex items-center justify-center p-6">
  <div class="w-full max-w-md rounded-2xl border border-white/5 bg-[#141414] p-8">

    <div class="flex items-center gap-3 mb-6">
      <div class="w-11 h-11 rounded-xl bg-yellow-400 text-black flex items-center justify-center font-black">DJ</div>
      <div>
        <p class="font-bold text-yellow-400">DJs HRMS</p>
        <p class="text-xs text-gray-500">XianFire ERP System</p>
      </div>
    </div>

    <h1 class="text-2xl font-bold">Forgot your password?</h1>
    <p class="mt-2 text-sm text-gray-400">
      Enter the email you sign in with. Your request goes to the HR administrator, who will give you
      a one-time link to set a new password.
    </p>

    <div class="space-y-4 mt-5">{{> flash}}</div>

    <form method="POST" action="/forgot-password" class="mt-5 space-y-4">
      <div>
        <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Email address</label>
        <input id="email" type="email" name="email" required autofocus autocomplete="email" placeholder="you@company.com"
               class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
      </div>
      <button type="submit" class="w-full rounded-xl bg-yellow-400 px-4 py-3 text-sm font-bold text-black transition hover:bg-yellow-300">
        Send request to HR
      </button>
    </form>

    <ol class="mt-6 space-y-1.5 rounded-xl border border-white/5 bg-white/[0.02] p-4 text-xs text-gray-400 list-decimal list-inside">
      <li>Send this request.</li>
      <li>HR gives you a reset link (it works once, for 30 minutes).</li>
      <li>Open the link and choose a new password.</li>
    </ol>

    <p class="mt-6 text-center text-sm text-gray-500">
      Remembered it?
      <a href="/login" class="font-semibold text-yellow-400 hover:text-yellow-300">Back to sign in</a>
    </p>
  </div>
</div>
</body>
</html>
