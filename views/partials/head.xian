<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if title}}{{title}}{{else}}DJs HRMS{{/if}}</title>
  <link rel="icon" type="image/svg+xml" href="/images/djs-logo.svg">
  <script>
    (function () {
      try {
        if (localStorage.getItem("hrms-theme") === "light") {
          document.documentElement.classList.add("light");
          document.documentElement.classList.remove("dark");
        }
      } catch (error) { /* storage unavailable */ }
    })();
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { gold: "#FACC15" },
          fontFamily: { sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] }
        }
      }
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    html { color-scheme: dark; }
    body { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    input[type="date"]::-webkit-calendar-picker-indicator,
    input[type="month"]::-webkit-calendar-picker-indicator,
    input[type="time"]::-webkit-calendar-picker-indicator { filter: invert(1); opacity: .55; }
    @media print {
      .no-print { display: none !important; }
      body { background: #fff !important; color: #000 !important; }
      .print-card, .print-card * { background: #fff !important; color: #000 !important; border-color: #d1d5db !important; }
      .print-card { box-shadow: none !important; }
      table { page-break-inside: auto; }
      tr { page-break-inside: avoid; }
    }
  </style>
</head>
