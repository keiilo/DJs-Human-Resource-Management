{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5 no-print">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-xl md:text-2xl font-bold">Payslip</h2>
          <p class="text-sm text-gray-500 mt-1">
            {{#if payroll.employee}}{{payroll.employee.firstName}} {{payroll.employee.lastName}}{{/if}} · {{formatDate payroll.periodStart}} – {{formatDate payroll.periodEnd}}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="window.print()" class="rounded-xl bg-yellow-400 px-4 py-2.5 text-sm font-bold text-black hover:bg-yellow-300">Print Payslip</button>
          <a href="{{#if isLimited}}/my-payslips{{else}}/payroll{{/if}}" class="rounded-xl border border-white/10 px-4 py-2.5 text-sm text-gray-300 hover:bg-white/5">Back</a>
        </div>
      </div>
    </header>

    <section class="p-6 max-w-3xl space-y-6">

      {{> flash}}

      <div class="print-card rounded-2xl border border-white/5 bg-white text-black p-8">

        <div class="flex flex-wrap items-start justify-between gap-4 border-b border-gray-200 pb-5">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-yellow-400 flex items-center justify-center font-black text-black">DJ</div>
            <div>
              <p class="font-black text-lg leading-tight">DJs Human Resource Management</p>
              <p class="text-xs text-gray-500">XianFire ERP System · Payslip</p>
            </div>
          </div>
          <div class="text-right">
            <p class="text-xs uppercase tracking-widest text-gray-500">Payroll Status</p>
            <p class="font-bold">{{payroll.status}}</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 py-5 text-sm">
          <div>
            <p class="text-[11px] uppercase tracking-widest text-gray-500">Employee</p>
            <p class="font-semibold">{{#if employee}}{{employee.firstName}} {{employee.lastName}}{{else}}—{{/if}}</p>
            <p class="text-xs text-gray-500">{{#if employee}}{{employee.employeeCode}} · {{employee.position}}{{/if}}</p>
            <p class="text-xs text-gray-500">{{#if employee}}{{employee.department}}{{/if}}</p>
          </div>
          <div class="text-right">
            <p class="text-[11px] uppercase tracking-widest text-gray-500">Pay Period</p>
            <p class="font-semibold">{{formatDate payroll.periodStart}} – {{formatDate payroll.periodEnd}}</p>
            <p class="text-xs text-gray-500">Issued {{formatDate payroll.updatedAt}}</p>
          </div>
        </div>

        <table class="w-full text-sm border-t border-gray-200">
          <thead>
            <tr class="text-left text-[11px] uppercase tracking-widest text-gray-500">
              <th class="py-3">Earnings</th>
              <th class="py-3 text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2.5">Basic Salary</td><td class="py-2.5 text-right">{{formatMoney payroll.basicSalary}}</td></tr>
            <tr><td class="py-2.5">Allowances</td><td class="py-2.5 text-right">{{formatMoney payroll.allowances}}</td></tr>
            <tr><td class="py-2.5">Overtime</td><td class="py-2.5 text-right">{{formatMoney payroll.overtime}}</td></tr>
          </tbody>
        </table>

        <table class="w-full text-sm border-t border-gray-200 mt-4">
          <thead>
            <tr class="text-left text-[11px] uppercase tracking-widest text-gray-500">
              <th class="py-3">Deductions</th>
              <th class="py-3 text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2.5">Total Deductions</td><td class="py-2.5 text-right">{{formatMoney payroll.deductions}}</td></tr>
          </tbody>
        </table>

        <div class="mt-6 flex items-center justify-between border-t-2 border-black pt-4">
          <p class="font-bold uppercase tracking-wider text-sm">Net Pay</p>
          <p class="text-xl font-black">{{formatMoney payroll.netSalary}}</p>
        </div>

        <p class="mt-6 text-[10px] text-gray-500">
          This payslip is generated by DJs HRMS. Figures are based on the payroll record for the stated period.
        </p>
      </div>

      {{#if canManage}}
      <div class="no-print rounded-2xl border border-white/5 bg-[#171717] p-5 space-y-4">
        <h3 class="font-bold">Manage Payroll Record</h3>

        <form method="POST" action="/payroll/{{payroll.id}}/status" class="flex flex-wrap items-end gap-3">
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-500 mb-2">Status</label>
            <select name="status" class="rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-2.5 text-sm outline-none focus:border-yellow-400/60">
              {{#each statuses}}
              <option value="{{this}}" {{#if (eq this ../payroll.status)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
          </div>
          <button type="submit" class="rounded-xl bg-yellow-400 px-5 py-2.5 text-sm font-bold text-black hover:bg-yellow-300">Update Status</button>
        </form>

        <form action="/payroll/{{payroll.id}}/delete" method="POST" onsubmit="return confirm('Delete this payroll record?');">
          <button type="submit" class="rounded-xl bg-red-500/10 px-4 py-2.5 text-sm text-red-400 hover:bg-red-500 hover:text-white">Delete Record</button>
        </form>
      </div>
      {{/if}}

    </section>
  </main>
</div>

{{> footer}}
