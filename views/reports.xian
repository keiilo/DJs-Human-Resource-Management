{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5">
      <h2 class="text-xl md:text-2xl font-bold">Reports</h2>
      <p class="text-sm text-gray-500 mt-1">Generate printable HR reports from live database records.</p>
    </header>

    <section class="p-6 space-y-6">

      {{> flash}}

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {{#each reports}}
        <a href="/reports/{{type}}" class="group rounded-2xl border border-white/5 bg-[#171717] p-5 hover:border-yellow-400/30 hover:bg-yellow-400/5 transition">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-bold text-lg group-hover:text-yellow-400">{{label}}</h3>
            <span class="text-yellow-400">▥</span>
          </div>
          <p class="mt-2 text-sm text-gray-400">{{description}}</p>
          <p class="mt-4 text-xs text-gray-500">Date range: {{formatDate ../from}} – {{formatDate ../to}}</p>
          <p class="mt-3 text-xs font-semibold text-yellow-400">Open report →</p>
        </a>
        {{/each}}
      </div>

      <div class="rounded-2xl border border-white/5 bg-[#171717] p-5">
        <h3 class="font-bold">About these reports</h3>
        <p class="mt-2 text-sm text-gray-400">
          Reports read directly from MySQL. Opening a report lets you choose a date range (where relevant)
          and print or save it as PDF using your browser's print dialog.
        </p>
        {{#unless isAdmin}}
        <p class="mt-2 text-xs text-gray-500">Payroll reports are restricted to administrators.</p>
        {{/unless}}
      </div>

    </section>
  </main>
</div>

{{> footer}}
