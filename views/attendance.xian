{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-xl md:text-2xl font-bold">Attendance Management</h2>
          <p class="text-sm text-gray-500 mt-1">Record daily attendance, check-in and check-out times.</p>
        </div>
        <a href="/reports/attendance?from={{date}}&to={{date}}" class="rounded-xl border border-white/10 px-4 py-2.5 text-sm text-gray-300 hover:bg-white/5 no-print">
          Print daily report
        </a>
      </div>
    </header>

    <section class="p-6 space-y-6">

      {{> flash}}

      <form method="GET" action="/attendance" class="rounded-2xl border border-white/5 bg-[#171717] p-4 flex flex-wrap items-end gap-3 no-print">
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-500 mb-2">Date</label>
          <input type="date" name="date" value="{{date}}"
                 class="rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-2.5 text-sm outline-none focus:border-yellow-400/60">
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-500 mb-2">Department</label>
          <select name="department" class="rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-2.5 text-sm outline-none focus:border-yellow-400/60">
            <option value="">All departments</option>
            {{#each departments}}
            <option value="{{this}}" {{#if (eq this ../department)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <button type="submit" class="rounded-xl bg-yellow-400 px-5 py-2.5 text-sm font-bold text-black hover:bg-yellow-300">Load</button>
        <p class="ml-auto text-xs text-gray-500">Showing {{formatDate date}}</p>
      </form>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-2xl border border-white/5 bg-[#171717] p-4">
          <p class="text-xs text-gray-500 uppercase tracking-wider">Present</p>
          <h3 class="text-2xl font-black mt-2 text-green-400">{{summary.present}}</h3>
        </div>
        <div class="rounded-2xl border border-white/5 bg-[#171717] p-4">
          <p class="text-xs text-gray-500 uppercase tracking-wider">Late</p>
          <h3 class="text-2xl font-black mt-2 text-orange-400">{{summary.late}}</h3>
        </div>
        <div class="rounded-2xl border border-white/5 bg-[#171717] p-4">
          <p class="text-xs text-gray-500 uppercase tracking-wider">Absent</p>
          <h3 class="text-2xl font-black mt-2 text-red-400">{{summary.absent}}</h3>
        </div>
        <div class="rounded-2xl border border-white/5 bg-[#171717] p-4">
          <p class="text-xs text-gray-500 uppercase tracking-wider">Not recorded</p>
          <h3 class="text-2xl font-black mt-2 text-gray-400">{{summary.unrecorded}}</h3>
        </div>
      </div>

      <div class="rounded-2xl border border-white/5 bg-[#171717] overflow-hidden">
        <div class="p-5 border-b border-white/5 flex items-center justify-between">
          <h3 class="font-bold">Daily Attendance Sheet</h3>
          <p class="text-xs text-gray-500">{{summary.total}} employee(s)</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="bg-white/5 text-gray-400 uppercase text-[11px]">
              <tr>
                <th class="px-5 py-3">Employee</th>
                <th class="px-5 py-3">Department</th>
                <th class="px-5 py-3">Check In</th>
                <th class="px-5 py-3">Check Out</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3">Late</th>
                <th class="px-5 py-3 text-right">Record</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {{#each rows}}
              <tr class="align-top hover:bg-white/5">
                <td class="px-5 py-3">
                  <p class="font-medium">{{name}}</p>
                  <p class="text-xs text-gray-500">{{code}}</p>
                </td>
                <td class="px-5 py-3 text-gray-400">{{department}}</td>
                <td class="px-5 py-3 text-gray-400">{{formatTime checkIn}}</td>
                <td class="px-5 py-3 text-gray-400">{{formatTime checkOut}}</td>
                <td class="px-5 py-3">
                  <span class="rounded-full px-2.5 py-1 text-[11px] {{#if (eq status "Present")}}bg-green-500/10 text-green-400{{else}}{{#if (eq status "Late")}}bg-orange-500/10 text-orange-400{{else}}{{#if (eq status "Absent")}}bg-red-500/10 text-red-400{{else}}{{#if (eq status "Half Day")}}bg-blue-500/10 text-blue-400{{else}}bg-white/5 text-gray-400{{/if}}{{/if}}{{/if}}{{/if}}">{{status}}</span>
                </td>
                <td class="px-5 py-3 text-gray-400">{{lateMinutes}} min</td>
                <td class="px-5 py-3 text-right">
                  <details class="no-print">
                    <summary class="cursor-pointer text-xs text-yellow-400 hover:underline">Edit</summary>
                    <form method="POST" action="/attendance" class="mt-3 w-64 space-y-2 rounded-xl border border-white/10 bg-[#0F0F0F] p-3 text-left">
                      <input type="hidden" name="employeeId" value="{{employeeId}}">
                      <input type="hidden" name="date" value="{{../date}}">
                      <div>
                        <label class="text-[10px] uppercase tracking-wider text-gray-500">Check in</label>
                        <input type="time" name="checkIn" value="{{checkIn}}"
                               class="w-full rounded-lg border border-white/10 bg-[#171717] px-3 py-2 text-xs outline-none focus:border-yellow-400/60">
                      </div>
                      <div>
                        <label class="text-[10px] uppercase tracking-wider text-gray-500">Check out</label>
                        <input type="time" name="checkOut" value="{{checkOut}}"
                               class="w-full rounded-lg border border-white/10 bg-[#171717] px-3 py-2 text-xs outline-none focus:border-yellow-400/60">
                      </div>
                      <div>
                        <label class="text-[10px] uppercase tracking-wider text-gray-500">Status</label>
                        <select name="status" class="w-full rounded-lg border border-white/10 bg-[#171717] px-3 py-2 text-xs outline-none focus:border-yellow-400/60">
                          {{#each ../statuses}}
                          <option value="{{this}}" {{#if (eq this ../status)}}selected{{/if}}>{{this}}</option>
                          {{/each}}
                        </select>
                      </div>
                      <div>
                        <label class="text-[10px] uppercase tracking-wider text-gray-500">Remarks</label>
                        <input name="remarks" value="{{remarks}}" placeholder="Optional"
                               class="w-full rounded-lg border border-white/10 bg-[#171717] px-3 py-2 text-xs outline-none focus:border-yellow-400/60">
                      </div>
                      <button type="submit" class="w-full rounded-lg bg-yellow-400 px-3 py-2 text-xs font-bold text-black hover:bg-yellow-300">Save</button>
                    </form>
                  </details>
                </td>
              </tr>
              {{else}}
              <tr><td colspan="7" class="px-5 py-12 text-center text-gray-500">No active employees found for this filter.</td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>

    </section>
  </main>
</div>

{{> footer}}
