{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5">
      <h2 class="text-xl md:text-2xl font-bold">Edit Department</h2>
      <p class="text-sm text-gray-500 mt-1">{{department.name}}</p>
    </header>

    <section class="p-6 max-w-4xl space-y-6">

      {{> flash}}

      <form method="POST" action="/departments/{{department.id}}/edit" class="rounded-2xl border border-white/5 bg-[#171717] p-5 sm:p-6 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Department Name *</label>
            <input name="name" required value="{{department.name}}"
                   class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Code</label>
            <input name="code" value="{{department.code}}"
                   class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Department Head</label>
          <select name="headId" class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            <option value="">Unassigned</option>
            {{#each employees}}
            <option value="{{id}}" {{#if (eq id ../department.headId)}}selected{{/if}}>{{firstName}} {{lastName}} — {{position}}</option>
            {{/each}}
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Description</label>
          <textarea name="description" rows="3"
                    class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">{{department.description}}</textarea>
        </div>

        <p class="text-xs text-gray-500">
          Renaming a department also updates the department name on all assigned employee records.
        </p>

        <div class="flex flex-wrap gap-3 pt-1">
          <button type="submit" class="rounded-xl bg-yellow-400 px-6 py-3 text-sm font-bold text-black hover:bg-yellow-300">Save Changes</button>
          <a href="/departments" class="rounded-xl border border-white/10 px-6 py-3 text-sm font-semibold text-gray-300 hover:bg-white/5">Cancel</a>
        </div>
      </form>

      <div class="rounded-2xl border border-white/5 bg-[#171717] overflow-hidden">
        <div class="p-5 border-b border-white/5 flex items-center justify-between">
          <h3 class="font-bold">Assigned Employees</h3>
          <a href="/employees?department={{urlEncode department.name}}" class="text-xs text-yellow-400 hover:underline">Manage in directory →</a>
        </div>

        <form method="POST" action="/departments/{{department.id}}/assign" class="flex flex-wrap items-end gap-3 border-b border-white/5 px-5 py-4">
          <div class="flex-1 min-w-[14rem]">
            <label class="block text-[10px] uppercase tracking-wider text-gray-500 mb-2">Assign an employee to this department</label>
            <select name="employeeId" required class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-2.5 text-sm outline-none focus:border-yellow-400/60">
              <option value="">Select employee</option>
              {{#each employees}}
                {{#unless (eq this.department ../department.name)}}
                <option value="{{id}}">{{firstName}} {{lastName}} — {{position}} ({{department}})</option>
                {{/unless}}
              {{/each}}
            </select>
          </div>
          <button type="submit" class="rounded-xl bg-yellow-400 px-5 py-2.5 text-sm font-bold text-black hover:bg-yellow-300">Assign</button>
        </form>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="bg-white/5 text-gray-400 uppercase text-[11px]">
              <tr><th class="px-5 py-3">Employee</th><th class="px-5 py-3">Position</th><th class="px-5 py-3"></th></tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {{#each employees}}
                {{#if (eq this.department ../department.name)}}
                <tr>
                  <td class="px-5 py-3">{{firstName}} {{lastName}}</td>
                  <td class="px-5 py-3 text-gray-400">{{position}}</td>
                  <td class="px-5 py-3 text-right"><a href="/employees/{{id}}/edit" class="text-xs text-yellow-400 hover:underline">Change department</a></td>
                </tr>
                {{/if}}
              {{/each}}
            </tbody>
          </table>
        </div>
        <p class="px-5 py-4 text-xs text-gray-500 border-t border-white/5">
          To assign an employee, edit their record and choose this department.
        </p>
      </div>

    </section>
  </main>
</div>

{{> footer}}
