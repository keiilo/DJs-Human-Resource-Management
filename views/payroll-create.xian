{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5">
      <h2 class="text-xl md:text-2xl font-bold">Create Payroll</h2>
      <p class="text-sm text-gray-500 mt-1">Record salary, allowances, overtime and deductions for a pay period.</p>
    </header>

    <section class="p-6 max-w-4xl space-y-6">

      {{> flash}}

      <form method="POST" action="/payroll/create" class="rounded-2xl border border-white/5 bg-[#171717] p-5 sm:p-6 space-y-5">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Employee *</label>
            <select id="employeeSelect" name="employeeId" required class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
              <option value="">Select employee</option>
              {{#each employees}}
              <option value="{{id}}" data-salary="{{salary}}">{{firstName}} {{lastName}} — {{employeeCode}}</option>
              {{/each}}
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Status</label>
            <select name="status" class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
              {{#each statuses}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Period Start *</label>
            <input type="date" name="periodStart" required value="{{defaultStart}}"
                   class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Period End *</label>
            <input type="date" name="periodEnd" required value="{{defaultEnd}}"
                   class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
          </div>
        </div>

        <div class="border-t border-white/5 pt-5">
          <h3 class="font-bold mb-4">Compensation</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Basic Salary (₱)</label>
              <input id="basicSalary" type="number" name="basicSalary" min="0" step="0.01" placeholder="Uses employee salary if blank"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Allowances (₱)</label>
              <input type="number" name="allowances" min="0" step="0.01" value="0"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Overtime (₱)</label>
              <input type="number" name="overtime" min="0" step="0.01" value="0"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Deductions (₱)</label>
              <input type="number" name="deductions" min="0" step="0.01" value="0"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
          </div>

          <div class="mt-5 rounded-xl border border-yellow-500/20 bg-yellow-500/5 p-4 flex items-center justify-between">
            <span class="text-sm text-gray-300">Computed Net Salary</span>
            <span id="netPay" class="text-xl font-black text-yellow-400">₱0.00</span>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="submit" class="rounded-xl bg-yellow-400 px-6 py-3 text-sm font-bold text-black hover:bg-yellow-300">Save Payroll</button>
          <a href="/payroll" class="rounded-xl border border-white/10 px-6 py-3 text-sm font-semibold text-gray-300 hover:bg-white/5">Cancel</a>
        </div>
      </form>

    </section>
  </main>
</div>

<script>
  const calcInputs = document.querySelectorAll(".calc");
  const employeeSelect = document.getElementById("employeeSelect");
  const basicInput = document.getElementById("basicSalary");
  const netPay = document.getElementById("netPay");
  const money = (n) => "₱" + Number(n || 0).toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  const recalc = () => {
    const basic = Number(basicInput.value || 0);
    const allowances = Number(document.querySelector('[name="allowances"]').value || 0);
    const overtime = Number(document.querySelector('[name="overtime"]').value || 0);
    const deductions = Number(document.querySelector('[name="deductions"]').value || 0);
    netPay.textContent = money(basic + allowances + overtime - deductions);
  };

  employeeSelect.addEventListener("change", () => {
    const option = employeeSelect.options[employeeSelect.selectedIndex];
    if (option && option.dataset.salary && !basicInput.value) basicInput.value = Number(option.dataset.salary);
    recalc();
  });

  calcInputs.forEach((input) => input.addEventListener("input", recalc));
  recalc();
</script>

{{> footer}}
