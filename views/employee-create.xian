{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5">
      <h2 class="text-xl md:text-2xl font-bold">Add Employee</h2>
      <p class="text-sm text-gray-500 mt-1">Create a new employee record and link their account by email.</p>
    </header>

    <section class="p-6 max-w-4xl space-y-6">
      {{> flash}}
      {{> employee-form formAction="/employees/create" submitLabel="Save Employee"}}
    </section>
  </main>
</div>

{{> footer}}
