{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="min-h-screen flex items-center justify-center p-6">
  <div class="w-full max-w-md rounded-2xl border border-white/5 bg-[#141414] p-8">

    <div class="flex items-center gap-3 mb-6">
      <div class="w-11 h-11 rounded-xl bg-yellow-400 text-black flex items-center justify-center font-black">DJ</div>
      <div>
        <p class="font-bold text-yellow-400">DJs HRMS</p>
        <p class="text-xs text-gray-500">XianFire ERP System</p>
      </div>
    </div>

    <h1 class="text-2xl font-bold">Password assistance</h1>
    <p class="mt-3 text-sm text-gray-400">
      For security, password resets are handled by your HR administrator. Contact them and they will
      reset your account through the secure initialization process.
    </p>

    <div class="mt-6 rounded-xl border border-yellow-500/20 bg-yellow-500/5 p-4 text-sm text-yellow-200/90">
      Include your full name and registered email address in your request so HR can verify your identity.
    </div>

    <a href="/login" class="mt-6 inline-block w-full rounded-xl bg-yellow-400 px-4 py-3 text-center text-sm font-bold text-black hover:bg-yellow-300">
      Back to sign in
    </a>
  </div>
</div>
</body>
</html>
