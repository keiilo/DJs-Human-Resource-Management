{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="min-h-screen flex items-center justify-center p-6">
  <div class="w-full max-w-md rounded-2xl border border-white/5 bg-[#141414] p-8">

    <div class="flex items-center gap-3 mb-6">
      <div class="w-11 h-11 rounded-xl bg-yellow-400 text-black flex items-center justify-center font-black">DJ</div>
      <div>
        <p class="font-bold text-yellow-400">DJs HRMS</p>
        <p class="text-xs text-gray-500">XianFire ERP System</p>
      </div>
    </div>

    {{#if valid}}
    <h1 class="text-2xl font-bold">Set a new password</h1>
    <p class="mt-2 text-sm text-gray-400">
      For <span class="text-yellow-400 break-all">{{account.email}}</span>. This link works only once.
    </p>

    <div class="space-y-4 mt-5">{{> flash}}</div>

    <form method="POST" action="/reset-password/{{token}}" class="mt-5 space-y-4">
      <div>
        <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">New password</label>
        <input id="password" type="password" name="password" required minlength="8" autofocus autocomplete="new-password" placeholder="At least 8 characters"
               class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
      </div>
      <div>
        <label for="confirmPassword" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Confirm new password</label>
        <input id="confirmPassword" type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" placeholder="Repeat the new password"
               class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
      </div>
      <button type="submit" class="w-full rounded-xl bg-yellow-400 px-4 py-3 text-sm font-bold text-black transition hover:bg-yellow-300">
        Save new password
      </button>
    </form>
    {{else}}
    <h1 class="text-2xl font-bold">Link not valid</h1>
    <p class="mt-2 text-sm text-gray-400">
      This reset link is wrong, was already used, or has expired (links last 30 minutes).
      Send a new request and HR will give you a fresh link.
    </p>
    <a href="/forgot-password" class="mt-6 inline-block w-full rounded-xl bg-yellow-400 px-4 py-3 text-center text-sm font-bold text-black hover:bg-yellow-300">
      Request a new link
    </a>
    {{/if}}

    <p class="mt-6 text-center text-sm text-gray-500">
      <a href="/login" class="font-semibold text-yellow-400 hover:text-yellow-300">Back to sign in</a>
    </p>
  </div>
</div>
</body>
</html>
