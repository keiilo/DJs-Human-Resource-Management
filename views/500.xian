{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white flex items-center justify-center p-6">
  <div class="max-w-md w-full rounded-2xl border border-red-500/20 bg-[#141414] p-8 text-center">
    <div class="w-14 h-14 mx-auto rounded-2xl bg-red-500/10 text-red-400 flex items-center justify-center text-2xl font-black">500</div>
    <h1 class="mt-5 text-2xl font-bold">Something went wrong</h1>
    <p class="mt-2 text-sm text-gray-400">The request could not be completed. Check the server console for details.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/dashboard" class="rounded-xl bg-yellow-400 px-5 py-2.5 text-sm font-bold text-black hover:bg-yellow-300">Back to dashboard</a>
      <a href="/login" class="rounded-xl border border-white/10 px-5 py-2.5 text-sm text-gray-300 hover:bg-white/5">Sign in</a>
    </div>
  </div>
</body>
</html>
