{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5">
      <h2 class="text-xl md:text-2xl font-bold">My Profile</h2>
      <p class="text-sm text-gray-500 mt-1">Account details, employee record and password.</p>
    </header>

    <section class="p-6 max-w-4xl space-y-6">

      {{> flash}}

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <div class="rounded-2xl border border-white/5 bg-[#171717] p-6">
          <h3 class="font-bold mb-1">Account details</h3>
          <p class="text-xs text-gray-500 mb-5">Your name and the email you sign in with.</p>

          <form method="POST" action="/account/profile" class="space-y-4">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Full name</label>
              <input id="name" type="text" name="name" required minlength="2" autocomplete="name"
                     value="{{currentUser.name}}"
                     class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Email address</label>
              <input id="email" type="email" name="email" required autocomplete="email"
                     value="{{currentUser.email}}"
                     class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
              <span class="text-[11px] uppercase tracking-wider text-yellow-400">{{currentUser.role}} account</span>
              <button type="submit" class="rounded-xl bg-yellow-400 px-5 py-2.5 text-sm font-bold text-black hover:bg-yellow-300">
                Save changes
              </button>
            </div>
          </form>
        </div>

        <div class="rounded-2xl border border-white/5 bg-[#171717] p-6">
          <h3 class="font-bold mb-4">Employee Record</h3>
          {{#if employee}}
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Employee ID</dt><dd class="font-semibold text-yellow-400">{{employee.employeeCode}}</dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Department</dt><dd>{{employee.department}}</dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Position</dt><dd>{{employee.position}}</dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Status</dt><dd>{{employee.status}}</dd></div>
              <div class="flex justify-between gap-3"><dt class="text-gray-500">Date Hired</dt><dd>{{formatDate employee.dateHired}}</dd></div>
            </dl>
            <a href="/employees/{{employee.id}}" class="mt-5 inline-block rounded-xl bg-white/5 px-4 py-2.5 text-xs font-semibold text-yellow-400 hover:bg-yellow-400/10">
              View full employee record →
            </a>
          {{else}}
            {{#if isLimited}}
            <p class="text-sm text-gray-400">
              No employee record is linked yet. Ask HR to add or update your record using
              <span class="text-yellow-400">{{currentUser.email}}</span>; the link is created automatically.
            </p>
            {{else}}
            <p class="text-sm text-gray-400">This staff account is not linked to an employee record.</p>
            {{/if}}
          {{/if}}
        </div>
      </div>

      <div id="password" class="rounded-2xl border border-white/5 bg-[#171717] p-6">
        <h3 class="font-bold mb-1">Change Password</h3>
        <p class="text-xs text-gray-500 mb-4">Use a strong password with at least 8 characters.</p>

        <form method="POST" action="/account/password" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Current Password</label>
            <input type="password" name="currentPassword" required autocomplete="current-password"
                   class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">New Password</label>
            <input type="password" name="newPassword" required minlength="8" autocomplete="new-password"
                   class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Confirm New Password</label>
            <input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password"
                   class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
          </div>
          <div class="sm:col-span-3">
            <button type="submit" class="rounded-xl bg-yellow-400 px-5 py-3 text-sm font-bold text-black hover:bg-yellow-300">Update Password</button>
          </div>
        </form>
      </div>

    </section>
  </main>
</div>

{{> footer}}
